# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Telegram user id of the single owner. Everyone else is rejected.
OWNER_TELEGRAM_ID=0

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# SQLAlchemy async URL. For local dev via docker-compose:
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
# Used by Alembic (async driver, same engine family as the app):
ALEMBIC_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# ── Behaviour ─────────────────────────────────────────────────────────────
# IANA timezone used to display dates and to define "current month".
TIMEZONE=Europe/Moscow
# Default currency (MVP: RUB).
DEFAULT_CURRENCY=RUB

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
