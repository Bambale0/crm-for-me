# Fill in locally. Never commit .env.
BOT_TOKEN=
OWNER_TELEGRAM_ID=0

# Use a unique URL-safe password for Docker Compose (letters/digits/-/_).
POSTGRES_PASSWORD=replace_with_a_unique_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://crm:replace_with_a_unique_password@localhost:5432/crm
# Optional; when unset, migrations use DATABASE_URL.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://crm:replace_with_a_unique_password@localhost:5432/crm

TIMEZONE=Europe/Moscow
DEFAULT_CURRENCY=RUB
REMINDER_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
